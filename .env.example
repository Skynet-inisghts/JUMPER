# Everything here is optional. Without any of it a crawl still runs on the
# public RPC; `pnpm jumper doctor` shows which crawler goes without.

# Replace the default endpoints (comma separated; append #nologs to an
# endpoint that refuses eth_getLogs).
# RPC_URL=

# Wallet-history index for SCOUT and LEDGER (see docs/INDEX.md).
# JUMPER_INDEX_URL=
# JUMPER_INDEX_KEY=

# Blockscout key for KNOT funding lookups and dollar rates; free at
# https://dev.blockscout.com. Personal and rate limited; never commit it.
# BLOCKSCOUT_API_KEY=

# Domain printed on share cards.
# JUMPER_SITE_HOST=
